# >>> claude-code-lanes-starter (managed: the installer rewrites the lines between these markers)
# LF in the repository everywhere, so scripts and hooks behave the same on Windows and Unix.
* text=auto eol=lf

# Windows scripts keep CRLF: PowerShell 5.1 and cmd expect it.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files: never touch their line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
# <<< claude-code-lanes-starter
